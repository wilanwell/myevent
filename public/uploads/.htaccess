# Uploaded files are data only: never execute scripts here.
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .phar .php5 .php7 .php8 .pht
RemoveType .php .phtml .phar .php5 .php7 .php8 .pht
<FilesMatch "\.(php|phtml|phar|php\d|pht|shtml|cgi|pl|py|sh|asp|aspx|jsp|htaccess)$">
    Require all denied
</FilesMatch>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
