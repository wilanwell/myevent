# MyEvent - web root (public/). Works in any folder: /, /myevent, /events ...
# Application code, .env and storage live one level up, outside the web root.

Options -Indexes
DirectoryIndex index.php

# --- Block private files ---------------------------------------------------
# Environment files, SQL dumps, logs, docs, VCS metadata and shell scripts.
<FilesMatch "^\.|\.(sql|gz|log|md|example|ini|sh|lock|json|dist|xml|xsd|yml|yaml|phar)$">
    Require all denied
</FilesMatch>

# --- Performance -------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml text/calendar
</IfModule>

# CSS/JS URLs carry a ?v= version, and uploads have random names, so they can be cached for long.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 30 days"
    ExpiresByType application/javascript "access plus 30 days"
    ExpiresByType text/javascript "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/gif "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
</IfModule>
