# MyEvent - project root.
#
# Only public/ is the web root. Best practice is to point the web server's document root at
# public/ directly (see DEPLOY.md). When that is not possible (XAMPP sub-folders, some shared
# hosts), these rules send every request into public/, so nothing else in this folder
# (.env, include/, storage/, database/, tools/, vendor/ ...) can ever be reached over the web.

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    # /myevent/ -> public/ ; /myevent/users/x.php -> public/users/x.php
    RewriteRule ^$ public/ [L]
    RewriteRule ^((?!public/).*)$ public/$1 [L]
</IfModule>

# Without mod_rewrite, refuse everything rather than expose the project files.
<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>
