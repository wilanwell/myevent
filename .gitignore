# Local environment (contains credentials)
.env

# Composer dependencies and PHPUnit cache
/vendor/
.phpunit.cache/

# Runtime data
storage/logs/*
!storage/logs/.gitkeep
storage/backups/*
!storage/backups/.gitkeep

# User uploads (the .htaccess that blocks script execution IS tracked)
public/uploads/events/*
public/uploads/profiles/*
!public/uploads/.htaccess
!public/uploads/events/.gitkeep
!public/uploads/profiles/.gitkeep
storage/mail/*
!storage/mail/.gitkeep
