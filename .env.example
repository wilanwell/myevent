# Copy this file to .env and adjust the values for your environment.
APP_NAME=MyEvent
# PHP and MySQL use this zone for "today", deadlines and timestamps.
APP_TIMEZONE=Asia/Kuala_Lumpur
APP_URL=http://localhost/myevent
# Never enable debug on a public server.
APP_DEBUG=false
# Secret used to sign ticket QR codes. Generate with:
#   php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# Mail: "log" saves emails to storage/mail (development); "smtp" sends them.
MAIL_DRIVER=smtp
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=MyEvent
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# tls (STARTTLS, port 587) or ssl (port 465)
SMTP_ENCRYPTION=tls

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=myevent
DB_USERNAME=myevent_app
DB_PASSWORD=change-me

# Backups (php tools/backup.php). Full path if mysqldump is not on PATH.
MYSQLDUMP_PATH=mysqldump
BACKUP_KEEP=14
# Set to true only behind a reverse proxy / load balancer that sets X-Forwarded-Proto.
APP_TRUST_PROXY=false
